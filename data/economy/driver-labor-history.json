{
  "schema_version": "1.0",
  "dataset": "driver-labor-history",
  "title_ja": "トラック運転者の労働時間長期推移",
  "frequency": "annual",
  "sources": [
    {
      "name": "厚生労働省 自動車運転者の長時間労働改善に向けたポータル - 改善基準告示学習テキスト",
      "url": "https://driver-roudou-jikan.mhlw.go.jp/pdf/ltxt-truck.pdf",
      "underlying_source": "厚生労働省 賃金構造基本統計調査"
    }
  ],
  "notes": [
    "2014～2022年は厚生労働省学習テキスト掲載の賃金構造基本統計調査ベース年次系列を使用する。",
    "大型トラック運転者と中小型トラック運転者を分け、全産業平均を比較基準として保持する。",
    "2025年job tagの月間労働時間は処理済み職業統計であり、この年次系列へ直接接続しない。",
    "2024年4月の時間外労働上限規制・改善基準告示改正前のベースラインとして利用する。"
  ],
  "series": [
    {
      "metric_id": "large_truck_driver_annual_work_hours",
      "name_ja": "大型トラック運転者 年間労働時間",
      "unit": "hours_year",
      "observations": [
        {"period":"2014","value":2592,"status":"official_secondary","source":"MHLW portal / Wage Structure Survey"},
        {"period":"2015","value":2616,"status":"official_secondary","source":"同上"},
        {"period":"2016","value":2604,"status":"official_secondary","source":"同上"},
