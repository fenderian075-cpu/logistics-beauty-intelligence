    {"metric_id":"stress_without_freight_vacancy","name_ja":"貨物求人圧力を除外","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_without_aging","name_ja":"高齢化圧力を除外","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_without_replacement","name_ja":"世代交代圧力を除外","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_without_working_age","name_ja":"生産年齢人口圧力を除外","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_leave_one_out_min","name_ja":"leave-one-out 最小値","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_leave_one_out_max","name_ja":"leave-one-out 最大値","unit":"index_2018_100","observations":[]},
    {"metric_id":"stress_leave_one_out_range","name_ja":"leave-one-out レンジ","unit":"index_points","observations":[]}
  ]
