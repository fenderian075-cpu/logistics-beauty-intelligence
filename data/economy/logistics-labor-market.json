{
  "schema_version": "1.1",
  "dataset": "logistics-labor-market",
  "title_ja": "物流人材需給・賃金",
  "frequency": "annual+fiscal",
  "sources": [
    {
      "name": "厚生労働省 職業情報提供サイト job tag - トラックドライバー",
      "url": "https://shigoto.mhlw.go.jp/User/Occupation/Detail/477",
      "underlying_sources": ["令和7年賃金構造基本統計調査", "ハローワーク求人統計"]
    },
    {
      "name": "国土交通省 地域の担い手不足 交通・物流",
      "url": "https://www.mlit.go.jp/policy/shingikai/content/001618218.pdf",
      "underlying_source": "厚生労働省 一般職業紹介状況"
    }
  ],
  "notes": [
    "job tagのトラックドライバー統計は関連する複数職業を加工・集約した職業情報で、道路貨物運送業という産業統計や、国土交通省が示す貨物自動車運転手系列とは定義が異なる。",
    "分類非互換性は同年度値でも確認できる。2024年度job tag『トラックドライバー』有効求人倍率は3.2倍だが、国土交通省資料の『貨物自動車運転手（パート含む）』は2.37倍。このため2025年度job tag 2.94倍を2018–2024の貨物運転者系列へ接続しない。",
    "有効求人倍率は労働供給の逼迫度を表す。高いほど求人に対する求職者が少ない。",
    "2025年度の求人賃金は求人票ベース、年収・年齢・労働時間は2025年賃金構造基本統計調査をjob tagが加工した就業者統計であり、同一概念ではない。"
  ],
  "compatibility_checks": {
    "job_tag_vs_freight_driver_vacancy": {
      "status": "not_comparable_for_time_series_append",
      "evidence_period": "2024FY",
      "job_tag_truck_driver_ratio": 3.2,
      "mlit_freight_automobile_driver_ratio": 2.37,
      "decision": "Keep job-tag 2025FY 2.94 as a standalone current snapshot; do not append to freight-driver history or Stress v1."
    }
  },
  "series": [
    {
      "metric_id": "truck_driver_average_age_2025",
      "name_ja": "トラックドライバー 平均年齢",
      "unit": "years",
      "observations": [{"period":"2025","value":51.5,"status":"official_processed","source":"厚生労働省 job tag / 令和7年賃金構造基本統計調査"}]
    },
    {
      "metric_id": "truck_driver_annual_income",
      "name_ja": "トラックドライバー 年収",
