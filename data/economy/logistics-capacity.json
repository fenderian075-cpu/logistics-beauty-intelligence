        {"period":"2019","value":34.2,"status":"derived","source":"同上"},
        {"period":"2020","value":38.3,"status":"derived","source":"同上"},
        {"period":"2021","value":39.5,"status":"derived","source":"同上"},
        {"period":"2022","value":40.1,"status":"derived","source":"同上"},
        {"period":"2023","value":40.3,"status":"derived","source":"同上"},
        {"period":"2024","value":40.6,"status":"derived","source":"同上"}
      ]
    },
